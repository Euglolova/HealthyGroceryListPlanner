@model List<HealthGroceryListPlanner.Web.Models.ShoppingList>

<h2>My Shopping Lists</h2>

<a asp-action="Create" class="btn btn-success mb-3">
    + Create New List
</a>

<table class="table">
    <thead>
        <tr>
            <th>Title</th>
            <th>Created</th>
            <th>Total Products</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
@foreach (var list in Model)
{
        <tr>
            <td>@list.Title</td>

            <td>
                @list.CreatedAt.ToString(
                    "MMMM dd, yyyy",
                    new System.Globalization.CultureInfo("en-US"))
            </td>

            <td>
                @(list.Products?.Count ?? 0)
            </td>

            <td>
                <div class="d-flex gap-2">

                    <a asp-controller="Products"
                       asp-action="List"
                       asp-route-id="@list.Id"
                       class="btn btn-primary btn-sm">
                        Open
                    </a>

                    <a asp-controller="ShoppingList"
                       asp-action="Delete"
                       asp-route-id="@list.Id"
                       class="btn btn-danger btn-sm">
                        Delete
                    </a>

                </div>
            </td>
        </tr>
}
    </tbody>
</table>