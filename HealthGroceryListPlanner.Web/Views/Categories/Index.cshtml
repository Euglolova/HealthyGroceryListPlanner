@model IEnumerable<HealthGroceryListPlanner.Domain.Models.Category>


<div class="container mt-4">

     <h1 class="mb-4 fw-bold">Categories</h1>

    <a asp-action="Create" class="btn btn-success mb-4">
        + Add Category
    </a>

    <div class="row">

        @foreach (var category in Model)
        {
            <div class="col-lg-3 col-md-4 col-sm-6 mb-4">
                <div class="card shadow-sm h-100 category-card">

                    <a asp-action="Details"
                       asp-route-id="@category.Id"
                       class="text-decoration-none text-dark">

                        <img src="@(string.IsNullOrEmpty(category.ImageUrl) 
                                    ? "/images/default-category.png" 
                                    : category.ImageUrl)"
                             class="card-img-top"
                             style="height:200px; object-fit:cover;" />

                        <div class="card-body text-center">
                            <h5 class="fw-bold">@category.Name</h5>
                        </div>

                    </a>

                    <div class="card-footer text-center category-actions">

                        <a asp-action="Delete"
                           asp-route-id="@category.Id"
                           class="btn btn-outline-danger btn-sm">
                           Delete
                        </a>

                    </div>

                </div>
            </div>
        }

    </div>
</div>