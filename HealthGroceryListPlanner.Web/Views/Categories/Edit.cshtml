@model HealthGroceryListPlanner.Web.Models.Category

<h2>Edit Category</h2>

<form asp-action="Edit">

    <input type="hidden" asp-for="Id"/>

    <div class="mb-3">
        <label>Name</label>
        <input asp-for="Name" class="form-control"/>
    </div>

    <div class="mb-3">
        <label>Emoji</label>
        <input asp-for="Emoji" class="form-control"/>
    </div>

    <button type="submit" class="btn btn-success">
        Save
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancel
    </a>

</form>