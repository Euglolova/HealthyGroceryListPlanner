@{
    ViewData["Title"] = "Settings";
}

<div class="container mt-5 mb-5">

    <!-- Success Message -->
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success">
            @TempData["Message"]
        </div>
    }

    <div class="text-center mb-4">
        <h2 class="fw-bold text-success">⚙ Application Settings</h2>
        <p class="text-muted">Customize your experience</p>
    </div>

    <!-- Main Settings Card -->
    <div class="card shadow-sm border-0">
        <div class="card-body">

            <form>

                <!-- Language -->
                <div class="mb-4">
                    <label class="form-label fw-bold">🌍 Language</label>
                    <select class="form-select">
                        <option selected>English</option>
                        <option>Русский</option>
                        <option>Українська</option>
                    </select>
                </div>

                <!-- Theme -->
                <div class="mb-4">
                    <label class="form-label fw-bold">🎨 Theme</label>
                    <select class="form-select">
                        <option selected>Light</option>
                        <option>Dark</option>
                    </select>
                </div>

                <!-- Units -->
                <div class="mb-4">
                    <label class="form-label fw-bold">📊 Units Preference</label>
                    <select class="form-select">
                        <option selected>Metric (kg, g, L)</option>
                        <option>Imperial (lb, oz, fl oz)</option>
                    </select>
                </div>

                <!-- Notifications -->
                <div class="mb-3 form-check">
                    <input type="checkbox" class="form-check-input" id="notifications">
                    <label class="form-check-label fw-bold" for="notifications">
                        🔔 Enable Notifications
                    </label>
                </div>

                <!-- Auto Save -->
                <div class="mb-4 form-check">
                    <input type="checkbox" class="form-check-input" id="autosave" checked>
                    <label class="form-check-label fw-bold" for="autosave">
                        💾 Enable Auto-Save
                    </label>
                </div>

                <!-- Save Button -->
                <button type="submit" class="btn btn-success">
                    Save Settings
                </button>

            </form>

        </div>
    </div>

    <!-- Danger Zone -->
    <div class="card shadow-sm border-danger mt-5">
        <div class="card-body">

            <h5 class="text-danger fw-bold">⚠ Danger Zone</h5>
            <p class="text-muted small">
                Deleting your account will permanently remove all your data.
            </p>

            <button class="btn btn-outline-danger mb-3">
                Delete Account
            </button>

            <hr />

            <h6 class="text-danger fw-bold">🗑 Data Management</h6>

            <form asp-controller="Home"
                  asp-action="ClearAllProducts"
                  method="post"
                  onsubmit="return confirm('Are you sure you want to delete ALL products?');">

                @Html.AntiForgeryToken()

                <button type="submit" class="btn btn-danger mt-2">
                    Clear All Products
                </button>

            </form>

        </div>
    </div>

</div>