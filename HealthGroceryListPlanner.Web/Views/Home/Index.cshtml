@{
    ViewData["Title"] = "Home";
}

<div class="container mt-5">

    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold text-success">
            🥑 Healthy Grocery Planner
        </h1>
        <p class="lead text-muted">
            Organize your shopping and stay consistent.
        </p>
    </div>

    <div class="row g-4">

        <!-- 1. Shopping Lists -->
        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm h-100 border-0 text-center">
                <div class="card-body">
                    <h4>🛒</h4>
                    <h5 class="card-title mt-2">Shopping Lists</h5>
                    <p class="text-muted small">
                        Manage your shopping lists.
                    </p>
                    <a asp-controller="ShoppingList"
                       asp-action="Index"
                       class="btn btn-success w-100">
                        Open
                    </a>
                </div>
            </div>
        </div>

        <!-- 2. Items by Categories -->
        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm h-100 border-0 text-center">
                <div class="card-body">
                    <h4>📦</h4>
                    <h5 class="card-title mt-2">Items by Categories</h5>
                    <p class="text-muted small">
                        View products grouped by category.
                    </p>
                    <a asp-controller="Product"
                       asp-action="Index"
                       class="btn btn-outline-success w-100">
                        View Items
                    </a>
                </div>
            </div>
        </div>

        <!-- 3. My Profile -->
        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm h-100 border-0 text-center">
                <div class="card-body">
                    <h4>👤</h4>
                    <h5 class="card-title mt-2">My Profile</h5>
                    <p class="text-muted small">
                        Manage your personal information.
                    </p>
                    <a asp-controller="Account"
                       asp-action="Login"
                       class="btn btn-outline-secondary w-100">
                        Open Profile
                    </a>
                </div>
            </div>
        </div>

        <!-- 4. Settings -->
        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm h-100 border-0 text-center">
                <div class="card-body">
                    <h4>⚙</h4>
                    <h5 class="card-title mt-2">Settings</h5>
                    <p class="text-muted small">
                        Application preferences.
                    </p>
                    <a asp-controller="Home"
                       asp-action="Settings"
                       class="btn btn-outline-dark w-100">
                        Open
                    </a>
                </div>
            </div>
        </div>

    </div>
</div>