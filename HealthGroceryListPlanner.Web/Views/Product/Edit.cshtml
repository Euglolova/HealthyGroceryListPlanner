@model HealthGroceryListPlanner.Web.Models.Product
@using Microsoft.AspNetCore.Mvc.Rendering
@using HealthGroceryListPlanner.Web.Models.Enums

<h2>Edit Product</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />

    <div class="form-group">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="Quantity"></label>
        <input asp-for="Quantity" class="form-control" type="number" />
    </div>
    

    <div class="form-group">
        <label asp-for="Unit"></label>
        <select asp-for="Unit"
                asp-items="Html.GetEnumSelectList<UnitType>()"
                class="form-control">
        </select>
        <span asp-validation-for="Unit" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="CategoryId"></label>
        <select asp-for="CategoryId"
                class="form-control"
                asp-items="@(new SelectList(ViewBag.Categories, "Id", "Name", Model.CategoryId))">
        </select>
    </div>

    <div class="form-check">
        <input asp-for="IsPurchased" class="form-check-input" />
        <label asp-for="IsPurchased" class="form-check-label"></label>
    </div>

    <br />

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>