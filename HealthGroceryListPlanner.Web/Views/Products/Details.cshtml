@model HealthGroceryListPlanner.Domain.Models.Product
@using HealthGroceryListPlanner.Domain.Enums

<h2>Product Details</h2>

<hr />

<div>
    <p><strong>Product Name:</strong> @Model.Name</p>
    <p>
        <strong>Quantity:</strong>
       @Model.Quantity.ToString()
        @(
            Model.Unit switch
            {
                UnitType.Kilogram => "kg",
                UnitType.Pieces => "pcs",
                UnitType.Gram => "g",
                UnitType.Liter => "L",
                UnitType.Milliliter => "ml",
                _ => ""
            }
        )
    </p>
    <p><strong>Purchased:</strong> @(Model.IsPurchased ? "Yes" : "No")</p>
</div>

<br />

<div>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Delete</a>
    <a asp-action="Index" class="btn btn-secondary">Back to Grocery List</a>
</div>