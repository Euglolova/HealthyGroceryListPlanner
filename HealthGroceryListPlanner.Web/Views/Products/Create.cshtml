@model HealthGroceryListPlanner.Web.Models.Product

<div class="container mt-4">

    <h2 class="mb-4 text-center">Add Product</h2>

    <form asp-action="Create" method="post">

        <!-- ВАЖНО -->
        <input type="hidden" asp-for="CategoryId" />

        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Quantity" class="form-label"></label>
            <input asp-for="Quantity" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Unit" class="form-label"></label>
            <select asp-for="Unit" class="form-select"
                asp-items="Html.GetEnumSelectList<HealthGroceryListPlanner.Web.Models.Enums.UnitType>()">
            </select>
        </div>

        <div class="mb-3">
            <label asp-for="Emoji" class="form-label"></label>
            <input asp-for="Emoji" class="form-control" />
        </div>

        <button type="submit" class="btn btn-success w-100">
            Save
        </button>

    </form>

</div>