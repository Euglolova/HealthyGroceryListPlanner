@model List<HealthGroceryListPlanner.Web.Models.Product>
@using HealthGroceryListPlanner.Web.Models.Enums

<h2>Grocery List</h2>

<a asp-action="Create" class="btn btn-success">Add Product</a>

<br /><br />

<p>Total products: @Model.Count</p>

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Quantity</th>
            <th>Category</th>
            <th>Purchased</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
@foreach (var product in Model)
{
        <tr>
            <td>@product.Name</td>

            <td>
                @(product.Quantity.HasValue ? product.Quantity.Value.ToString("0.##") : "")
                @(
                    product.Unit switch
                    {
                        UnitType.Kilogram => "kg",
                        UnitType.Pieces => "pcs",
                        UnitType.Gram => "g",
                        UnitType.Liter => "L",
                        UnitType.Milliliter => "ml",
                        _ => ""
                    }
                )
            </td>

            <td>@product.Category?.Name</td>

            <td>
                <form asp-action="TogglePurchased" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@product.Id" />
                    <input type="checkbox"
                           onchange="this.form.submit()"
                           @(product.IsPurchased ? "checked" : "") />
                </form>
            </td>

            <td>
                <a asp-action="Details"
                   asp-route-id="@product.Id"
                   class="btn btn-info btn-sm">
                    Details
                </a>
            </td>
        </tr>
}
    </tbody>
</table>