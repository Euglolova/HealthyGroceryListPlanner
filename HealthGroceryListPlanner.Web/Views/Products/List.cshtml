@model List<HealthGroceryListPlanner.Domain.Models.Product>
@using HealthGroceryListPlanner.Domain.Enums

<h2>Products</h2>

<a asp-controller="Products"
   asp-action="SelectForList"
   asp-route-shoppingListId="@ViewBag.ShoppingListId"
   class="btn btn-success mb-3">
    + Add Product
</a>

<div class="mb-3 d-flex gap-2">
    <a asp-controller="ShoppingList"
       asp-action="Index"
       class="btn btn-info">
        ← Back to Shopping Lists
    </a>

    <a asp-controller="Home"
       asp-action="Index"
       class="btn btn-secondary">
        Home
    </a>
</div>

<table class="table table-hover">

    <thead>
        <tr>
            <th>Name</th>
            <th style="width:260px;">Amount</th>
            <th>Category</th>
            <th style="width:120px;"></th>
        </tr>
    </thead>

    <tbody>

@foreach (var product in Model)
{
    <tr>

        <!-- NAME -->
        <td class="fw-semibold">
            @product.Name
        </td>

        <!-- AMOUNT -->
        <td>
            <div class="d-inline-flex align-items-center gap-3">

                <!-- DECREASE -->
                <form asp-action="DecreaseQuantity" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="productId" value="@product.Id" />
                    <button type="submit" class="btn btn-link text-dark p-0 fs-4">−</button>
                </form>

                <!-- QUANTITY -->
                <span class="fw-semibold">
                    @product.Quantity
                </span>

                <!-- INCREASE -->
                <form asp-action="IncreaseQuantity" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="productId" value="@product.Id" />
                    <button type="submit" class="btn btn-link text-dark p-0 fs-4">+</button>
                </form>

                <!-- UNIT -->
                <form asp-action="UpdateUnit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="productId" value="@product.Id" />

                    <select name="unit"
                            class="form-select form-select-sm"
                            onchange="this.form.submit()">

                        @foreach (UnitType unit in Enum.GetValues(typeof(UnitType)))
                        {
                            var display = unit switch
                            {
                                UnitType.Pieces => "pcs",
                                UnitType.Kilogram => "kg",
                                UnitType.Gram => "g",
                                UnitType.Liter => "L",
                                UnitType.Milliliter => "ml",
                                _ => unit.ToString()
                            };

                            <option value="@unit" selected="@(unit == product.Unit)">
                                @display
                            </option>
                        }

                    </select>
                </form>

            </div>
        </td>

        <!-- CATEGORY -->
        <td class="text-muted">
            @product.Category?.Name
        </td>

        <!-- REMOVE FROM LIST -->
        <td class="text-end">
            <form asp-controller="Products"
                asp-action="RemoveFromList"
                method="post"
                style="display:inline;">

                @Html.AntiForgeryToken()

                <input type="hidden" name="productId" value="@product.Id" />

                <!-- 🔥 ВОТ ЭТО ДОБАВЬ -->
                <input type="hidden" name="shoppingListId" value="@ViewBag.ShoppingListId" />

                <button type="submit"
                        class="btn btn-danger btn-sm"
                        onclick="return confirm('Remove this product from the list?')">
                    Delete
                </button>

            </form>
        </td>

    </tr>
}

    </tbody>

</table>