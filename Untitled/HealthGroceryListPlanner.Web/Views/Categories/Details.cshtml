@model HealthGroceryListPlanner.Domain.Models.Category

<div class="container mt-4 position-relative">

    <h2 class="text-center mb-4">@Model.Name</h2>
    
    <div class="mb-3 d-flex gap-2">

    <a asp-controller="Categories"
       asp-action="Index"
       class="btn btn-info">
        ← Back to Categories
    </a>

    <a asp-controller="Home"
       asp-action="Index"
       class="btn btn-secondary">
        Home
    </a>

    </div>

    @if (Model.Products == null || !Model.Products.Any())
    {
        <div class="alert alert-light text-center">
            No products in this category yet.
        </div>
    }
    else
    {
        <div class="row">

            @foreach (var product in Model.Products)
            {
                <div class="col-6 col-md-4 col-lg-3 mb-4">

                    <div class="product-card text-center p-3 shadow-sm">

                        <div class="product-emoji">
                            @product.Emoji
                        </div>

                        <div class="product-name mt-2 fw-bold">
                            @product.Name
                        </div>

                        <div class="mt-3 d-flex justify-content-center gap-2">

                            <a asp-controller="Products"
                               asp-action="Edit"
                               asp-route-id="@product.Id"
                               class="btn btn-sm btn-outline-primary">
                                Edit
                            </a>

                            <a asp-controller="Products"
                               asp-action="Delete"
                               asp-route-id="@product.Id"
                               class="btn btn-sm btn-outline-danger">
                                Delete
                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>


<a asp-controller="Products"
   asp-action="Create"
   asp-route-categoryId="@Model.Id"
   class="btn btn-success rounded-circle d-flex align-items-center justify-content-center"
   style="position:fixed; bottom:30px; right:30px; width:60px; height:60px; font-size:28px;">
   +
</a>