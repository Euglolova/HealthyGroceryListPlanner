@model List<HealthGroceryListPlanner.Domain.Models.ShoppingList>

<h2 class="text-center mb-4">My Shopping Lists</h2>

<div class="d-flex gap-2 mb-3">

    <a asp-controller="Home"
       asp-action="Index"
       class="btn btn-secondary">
        Home
    </a>

        <a asp-action="Create" class="btn btn-success">
        + Create New List
    </a>

</div>

<table class="table">
    <thead>
        <tr>
            <th>Title</th>
            <th>Created</th>
            <th>Total Products</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
@foreach (var list in Model)
{
        <tr>
            <td>@list.Title</td>

            <td>
                @list.CreatedAt.ToString(
                    "MMMM dd, yyyy",
                    new System.Globalization.CultureInfo("en-US"))
            </td>

            <td>
                @(list.Products?.Count ?? 0)
            </td>

            <td>
                <div class="d-flex gap-2">

                    <a asp-controller="Products"
                       asp-action="List"
                       asp-route-id="@list.Id"
                       class="btn btn-primary btn-sm">
                        Open
                    </a>

                    <form asp-controller="ShoppingList"
                          asp-action="Delete"
                          asp-route-id="@list.Id"
                          method="post"
                          style="display:inline">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-danger btn-sm"
                                onclick="return confirm('Delete this list?')">
                            Delete
                        </button>

                    </form>

                </div>
            </td>
        </tr>
}
    </tbody>
</table>