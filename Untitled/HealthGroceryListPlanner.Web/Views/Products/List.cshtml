@model List<HealthGroceryListPlanner.Domain.Models.Product>
@using HealthGroceryListPlanner.Domain.Enums

<h2>Products</h2>

<a asp-controller="Products"
   asp-action="SelectForList"
   asp-route-shoppingListId="@ViewBag.ShoppingListId"
   class="btn btn-success mb-3">
    + Add Product
</a>
<div class="mb-3 d-flex gap-2">

    <a asp-controller="ShoppingList"
       asp-action="Index"
       class="btn btn-info">
        ← Back to Shopping Lists
    </a>

    <a asp-controller="Home"
       asp-action="Index"
       class="btn btn-secondary">
        Home
    </a>

</div>

<table class="table table-hover">

    <thead>
        <tr>
            <th>Name</th>
            <th style="width:260px;">Amount</th>
            <th>Category</th>
            <th style="width:120px;"></th>
        </tr>
    </thead>

    <tbody>

@foreach (var product in Model)
{
        <tr>

            <!-- PRODUCT NAME -->
            <td class="fw-semibold">
                @product.Name
            </td>


            <!-- AMOUNT -->
            <td>

                <div class="d-inline-flex align-items-center gap-3">

                    <!-- DECREASE -->
                    <form asp-action="DecreaseQuantity" method="post">
                        <input type="hidden" name="productId" value="@product.Id" />

                        <button type="submit"
                                class="btn btn-link text-dark p-0 fs-4 text-decoration-none">
                            −
                        </button>
                    </form>


                    <!-- QUANTITY -->
                    <span class="fw-semibold">
                        @(product.Quantity )
                    </span>


                    <!-- INCREASE -->
                    <form asp-action="IncreaseQuantity" method="post">
                        <input type="hidden" name="productId" value="@product.Id" />

                        <button type="submit"
                                class="btn btn-link text-dark p-0 fs-4 text-decoration-none">
                            +
                        </button>
                    </form>


                    <!-- UNIT SELECT -->
                <form asp-action="UpdateUnit" method="post">

                    <input type="hidden" name="productId" value="@product.Id" />

                    <select name="unit"
                            class="form-select form-select-sm"
                            onchange="this.form.submit()">

                        @foreach (UnitType unit in Enum.GetValues(typeof(UnitType)))
                        {
                            var display = unit switch
                            {
                                UnitType.Pieces => "pcs",
                                UnitType.Kilogram => "kg",
                                UnitType.Gram => "g",
                                UnitType.Liter => "L",
                                UnitType.Milliliter => "ml",
                                _ => unit.ToString()
                            };

                            <option value="@unit" selected="@(unit == product.Unit)">
                                @display
                            </option>
                        }

                    </select>

                </form>  


                </div>

            </td>


            <!-- CATEGORY -->
            <td class="text-muted">
                @product.Category?.Name
            </td>


            <!-- DELETE BUTTON -->
            <td class="text-end">

                <form asp-controller="Products"
                      asp-action="RemoveFromList"
                      method="post">

                    <input type="hidden" name="productId" value="@product.Id" />

                    <button class="btn btn-danger btn-sm">
                        Delete
                    </button>

                </form>

            </td>

        </tr>
}

    </tbody>

</table>