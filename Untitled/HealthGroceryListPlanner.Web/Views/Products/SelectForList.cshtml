@model List<HealthGroceryListPlanner.Domain.Models.Category>

<h2>Select Product</h2>

@foreach (var category in Model)
{
    <h4 class="mt-4">@category.Name</h4>

    <div class="row">

    @foreach (var product in category.Products)
    {
        <div class="col-md-3 mb-3">

            <div class="card p-3 text-center">

                <div style="font-size:30px">
                    @product.Emoji
                </div>

                <div>@product.Name</div>

                <form asp-controller="Products"
                      asp-action="AddToList"
                      method="post">

                    <input type="hidden" name="productId" value="@product.Id" />
                    <input type="hidden" name="shoppingListId" value="@ViewBag.ShoppingListId" />

                    <button class="btn btn-success btn-sm mt-2">
                        Add
                    </button>

                </form>

            </div>

        </div>
    }

    </div>
}